# 前端环境变量配置示例

# 本地开发：Mock 服务器密码（对应 scripts/dev-mock.mjs）
# 两种方式二选一，优先级 HASH > 明文：
#   - DEV_PASSWORD_HASH：密码的 SHA-256 哈希（推荐）
#   - DEV_PASSWORD：明文密码（Mock 服务器会自动哈希）
# 生成哈希：node -e "console.log(require('crypto').createHash('sha256').update('你的密码').digest('hex'))"
DEV_PASSWORD_HASH=your_password_hash_here
# 或使用明文（开发环境可选）
# DEV_PASSWORD=your_dev_password

# API 基础 URL（开发环境通常留空，使用 Vite 代理）
# 生产环境留空，自动使用当前域名
VITE_API_URL=

